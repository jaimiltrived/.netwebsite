<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="main.site.SiteMaster" %>

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - SVPMS</title>
    
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- SweetAlert2 -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />
    <!-- AOS Library -->
    <link href="https://unpkg.com/aos@next/dist/aos.css" rel="stylesheet" />
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="<%= ResolveUrl("~/assets/css/variables.css") %>" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/assets/css/style.css") %>" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/assets/css/forms.css") %>" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/assets/css/landing.css") %>" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/assets/css/responsive.css") %>" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/assets/css/dark-mode.css") %>" />

    <script>
        // Redirect active staff session immediately from public landing page
        const activeRole = localStorage.getItem('svpms_role');
        const path = window.location.pathname.toLowerCase();
        if (activeRole && (path.endsWith('default.aspx') || path.endsWith('index.aspx') || path === '/')) {
            window.location.href = activeRole + '/dashboard.aspx';
        }
    </script>

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <!-- Sticky Navigation Bar -->
    <nav class="navbar navbar-expand-lg glass-header sticky-top py-3">
        <div class="container">
            <a class="navbar-brand text-bold text-primary d-flex align-items-center gap-2" href="<%= ResolveUrl("~/Default.aspx") %>">
                <i class="bi bi-shield-check fs-3"></i>
                <span class="fs-4 text-bold text-color-primary">SVPMS</span>
            </a>
            
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar">
                <i class="bi bi-list fs-3"></i>
            </button>
            
            <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
                <div class="offcanvas-header border-bottom">
                    <h5 class="offcanvas-title text-bold text-primary d-flex align-items-center gap-2" id="offcanvasNavbarLabel">
                        <i class="bi bi-shield-check fs-3"></i>
                        <span>SVPMS</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                
                <div class="offcanvas-body">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-2">
                        <li class="nav-item"><a class="nav-link text-semibold" href="<%= ResolveUrl("~/Default.aspx") %>">Home</a></li>
                        <li class="nav-item"><a class="nav-link text-semibold" href="<%= ResolveUrl("~/features.aspx") %>">Features</a></li>
                        <li class="nav-item"><a class="nav-link text-semibold" href="<%= ResolveUrl("~/how-it-works.aspx") %>">How It Works</a></li>
                        <li class="nav-item"><a class="nav-link text-semibold" href="<%= ResolveUrl("~/pricing.aspx") %>">Pricing</a></li>
                        <li class="nav-item"><a class="nav-link text-semibold" href="<%= ResolveUrl("~/about.aspx") %>">About</a></li>
                        <li class="nav-item"><a class="nav-link text-semibold" href="<%= ResolveUrl("~/faq.aspx") %>">FAQ</a></li>
                        <li class="nav-item"><a class="nav-link text-semibold" href="<%= ResolveUrl("~/contact.aspx") %>">Contact</a></li>
                    </ul>
                    
                    <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0">
                        <!-- Theme Toggle Button -->
                        <button id="theme-toggle" class="btn btn-sm btn-link text-color-secondary p-0 border-0" type="button" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Toggle Dark/Light Mode">
                            <i class="bi bi-moon-fill fs-5"></i>
                        </button>
                        <a href="<%= ResolveUrl("~/visitor/index.aspx") %>" class="btn btn-outline-primary px-3 text-semibold">Visitor Portal</a>
                        <a href="<%= ResolveUrl("~/login.aspx") %>" class="btn btn-primary px-4 text-semibold shadow-sm">Sign In</a>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Placeholder -->
    <form id="siteForm" runat="server">
        <asp:ContentPlaceHolder ID="MainContent" runat="server">
        </asp:ContentPlaceHolder>
    </form>

    <!-- Global Public Footer -->
    <footer class="bg-card-theme pt-5 pb-4 border-top">
        <div class="container">
            <div class="row g-4 mb-5">
                <div class="col-lg-4 col-md-6 text-start">
                    <a class="navbar-brand text-bold text-primary d-flex align-items-center gap-2 mb-3" href="<%= ResolveUrl("~/Default.aspx") %>">
                        <i class="bi bi-shield-check fs-3"></i>
                        <span class="fs-4 text-bold text-color-primary">SVPMS</span>
                    </a>
                    <p class="fs-8 text-color-secondary">Smart Visitor Pass Management System designed to secure organization gates and simplify visitor logs.</p>
                </div>
                
                <div class="col-6 col-md-2 offset-md-1 text-start">
                    <h6 class="text-bold text-color-primary mb-3">Product</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2">
                        <li><a href="<%= ResolveUrl("~/features.aspx") %>" class="text-color-secondary text-decoration-none fs-8">Features</a></li>
                        <li><a href="<%= ResolveUrl("~/pricing.aspx") %>" class="text-color-secondary text-decoration-none fs-8">Pricing</a></li>
                        <li><a href="<%= ResolveUrl("~/security.aspx") %>" class="text-color-secondary text-decoration-none fs-8">Security</a></li>
                        <li><a href="<%= ResolveUrl("~/how-it-works.aspx") %>" class="text-color-secondary text-decoration-none fs-8">How It Works</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-2 text-start">
                    <h6 class="text-bold text-color-primary mb-3">Company</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2">
                        <li><a href="<%= ResolveUrl("~/about.aspx") %>" class="text-color-secondary text-decoration-none fs-8">About Us</a></li>
                        <li><a href="<%= ResolveUrl("~/contact.aspx") %>" class="text-color-secondary text-decoration-none fs-8">Contact</a></li>
                        <li><a href="<%= ResolveUrl("~/Default.aspx") %>" class="text-color-secondary text-decoration-none fs-8">Careers</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-2 text-start">
                    <h6 class="text-bold text-color-primary mb-3">Resources</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2">
                        <li><a href="<%= ResolveUrl("~/faq.aspx") %>" class="text-color-secondary text-decoration-none fs-8">FAQ Search</a></li>
                        <li><a href="<%= ResolveUrl("~/visitor/help.aspx") %>" class="text-color-secondary text-decoration-none fs-8">Help Center</a></li>
                        <li><a href="<%= ResolveUrl("~/faq.aspx") %>" class="text-color-secondary text-decoration-none fs-8">Documentation</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-2 text-start">
                    <h6 class="text-bold text-color-primary mb-3">Legal</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2">
                        <li><a href="<%= ResolveUrl("~/privacy.aspx") %>" class="text-color-secondary text-decoration-none fs-8">Privacy Policy</a></li>
                        <li><a href="<%= ResolveUrl("~/terms.aspx") %>" class="text-color-secondary text-decoration-none fs-8">Terms of Service</a></li>
                        <li><a href="<%= ResolveUrl("~/privacy.aspx") %>" class="text-color-secondary text-decoration-none fs-8">Cookie Policy</a></li>
                    </ul>
                </div>
            </div>
            
            <div class="border-top pt-4 text-center">
                <p class="mb-0 fs-8 text-color-muted">&copy; 2026 Smart Visitor Pass Management System. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Core Javascript Libraries -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://unpkg.com/aos@next/dist/aos.js"></script>
    
    <!-- Custom Scripts -->
    <script src="<%= ResolveUrl("~/assets/js/theme.js") %>"></script>
    <script src="<%= ResolveUrl("~/assets/js/animations.js") %>"></script>
    <script src="<%= ResolveUrl("~/assets/js/notifications.js") %>"></script>
    <script src="<%= ResolveUrl("~/assets/js/forms.js") %>"></script>
    <script src="<%= ResolveUrl("~/assets/js/app.js") %>"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof AOS !== 'undefined') {
                AOS.init({ duration: 600, once: true });
            }
            document.querySelectorAll('[data-aos]').forEach(function (el) {
                el.classList.add('aos-animate');
                el.style.opacity = '1';
            });
        });
    </script>

    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>
