<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Auth.Master.cs" Inherits="main.site.AuthMaster" %>

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - SVPMS</title>

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- SweetAlert2 -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />
    <!-- AOS Library -->
    <link href="https://unpkg.com/aos@next/dist/aos.css" rel="stylesheet" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="<%= ResolveUrl("~/assets/css/variables.css") %>" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/assets/css/style.css") %>" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/assets/css/components.css") %>" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/assets/css/forms.css") %>" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/assets/css/responsive.css") %>" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/assets/css/dark-mode.css") %>" />

    <style>
        /* Safety guarantee: Ensure authentication cards and visuals are always fully visible */
        [data-aos] {
            opacity: 1 !important;
            transform: none !important;
        }
    </style>

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="authForm" runat="server">
        <asp:ContentPlaceHolder ID="MainContent" runat="server">
        </asp:ContentPlaceHolder>
    </form>

    <!-- Core Javascript Libraries -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://unpkg.com/aos@next/dist/aos.js"></script>

    <!-- Custom Scripts -->
    <script src="<%= ResolveUrl("~/assets/js/theme.js") %>"></script>
    <script src="<%= ResolveUrl("~/assets/js/animations.js") %>"></script>
    <script src="<%= ResolveUrl("~/assets/js/notifications.js") %>"></script>
    <script src="<%= ResolveUrl("~/assets/js/forms.js") %>"></script>
    <script src="<%= ResolveUrl("~/assets/js/auth.js") %>"></script>
    <script src="<%= ResolveUrl("~/assets/js/app.js") %>"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof AOS !== 'undefined') {
                AOS.init({
                    duration: 600,
                    easing: 'ease-out-quad',
                    once: true
                });
            }
            // Ensure all elements are immediately visible
            document.querySelectorAll('[data-aos]').forEach(function (el) {
                el.classList.add('aos-animate');
                el.style.opacity = '1';
            });
        });
    </script>

    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>
